---
import '@/styles/fonts.css';
import '@/styles/ide.css';
import monoVar from '@/assets/fonts/jetbrains-mono-var.woff2?url';
import interVar from '@/assets/fonts/inter-var.woff2?url';
import { profile } from '@/data/profile';
import { DEFAULT_THEME, THEMES, THEME_STORAGE, themeCss } from '@/data/themes';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, ''), Astro.site);
/** for the inline script: each theme's background (the browser bar color), by id */
const themeBg = Object.fromEntries(THEMES.map((t) => [t.id, t.colors.bg]));
const themeMaxAge = THEME_STORAGE.months * 30.44 * 24 * 60 * 60 * 1000;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content={DEFAULT_THEME.colors.bg} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={monoVar} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interVar} as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="dev.nevcan.com" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="author" content={profile.name} />
    <style is:global set:html={themeCss()}></style>
    {/* the picked theme, before the first paint (lib/theme.ts reads and writes the same entry) */}
    <script is:inline define:vars={{ key: THEME_STORAGE.key, themeBg, themeMaxAge }}>
      try {
        const t = JSON.parse(localStorage.getItem(key) || 'null');
        if (t && themeBg[t.id] && Date.now() - t.at < themeMaxAge) {
          document.documentElement.dataset.theme = t.id;
          document.querySelector('meta[name="theme-color"]').content = themeBg[t.id];
        }
      } catch {
        /* blocked storage or bad JSON: the default theme */
      }
    </script>
  </head>
  <body>
    <slot />
  </body>
</html>
